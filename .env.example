# Copy to .env to override defaults used by docker compose.
# Host ports for `just up`. Change them if another program already uses them.
PLANWORLDSIMULATOR_WEB_PORT=8480
PLANWORLDSIMULATOR_API_PORT=8400

# Real world generation (`just world-setup`, then `just api-local` and `just web-local`).
# GEMINI_API_KEY=
# PLANWORLDSIMULATOR_GENERATOR_MODEL=google/gemini-3.5-flash  # 3.8-flash is about 6x slower
# PLANWORLDSIMULATOR_GENERATION_DEADLINE_SECONDS=300

# Seconds between fake generation steps (0 = instant).
PLANWORLDSIMULATOR_STEP_DELAY_SECONDS=1.0
